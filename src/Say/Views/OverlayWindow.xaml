<Window x:Class="Say.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Say"
        Width="620" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#3B82F6" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RecordBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F87171" Offset="0"/>
            <GradientStop Color="#DC2626" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DoneBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#34D399" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Live preview panel -->
        <Border x:Name="PreviewPanel"
                Grid.Row="0"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                MaxWidth="600"
                Margin="10,0,10,10"
                CornerRadius="18"
                Background="#E6131720"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Padding="16,12"
                IsHitTestVisible="False"
                Opacity="0"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PreviewTranslate" Y="12"/>
            </Border.RenderTransform>
            <ScrollViewer x:Name="PreviewScroll"
                          MaxHeight="150"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding PreviewText}"
                           Foreground="#E9EDF5"
                           FontSize="15"
                           LineHeight="22"
                           TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <!-- The pill -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,14">
            <Border x:Name="GlowRing"
                    CornerRadius="36"
                    BorderThickness="2"
                    BorderBrush="#F87171"
                    Opacity="0"
                    IsHitTestVisible="False"
                    Margin="-5,0"/>

            <Border x:Name="Pill"
                    Width="272" Height="62"
                    CornerRadius="31"
                    ClipToBounds="True"
                    Background="#F012151B"
                    BorderBrush="#2EFFFFFF"
                    BorderThickness="1"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="Pill_MouseDown"
                    PreviewMouseLeftButtonUp="Pill_MouseUp">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
                </Border.Effect>

                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mic button visual -->
                    <Border x:Name="MicCircle"
                            Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="21"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RecordBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DoneBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="17"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="MicRotate"/>
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE720;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                            <Setter Property="Text" Value="&#xE895;"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <!-- Live waveform -->
                    <StackPanel x:Name="Waveform"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,2,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Opacity" Value="0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.25"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[0]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[1]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[2]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[3]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#93C5FD" Height="{Binding Bars[4]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[5]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[6]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[7]}" VerticalAlignment="Center" Margin="1.5,0"/>
                        <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="#60A5FA" Height="{Binding Bars[8]}" VerticalAlignment="Center" Margin="1.5,0"/>
                    </StackPanel>

                    <!-- Status + hint -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,6,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="#EDF1F7"/>
                        <TextBlock Text="{Binding HintText}"
                                   FontSize="10.5"
                                   Foreground="#93A0B4"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Elapsed -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding ElapsedText}"
                               FontSize="11.5"
                               Foreground="#93A0B4"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
